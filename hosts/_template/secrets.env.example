# Keys expected in hosts/<host>/secrets.sops.env. Never fill this file in;
# create the encrypted file directly so plaintext never touches disk:
#
#   sops edit hosts/<host>/secrets.sops.env
#
# Per-stack secrets use the same <STACK>__ prefix as host.env.

# Portainer admin (created on first bootstrap). Minimum 12 characters.
PORTAINER_ADMIN_USER=admin
PORTAINER_ADMIN_PASSWORD=change-me-min-12-chars

# Lets Portainer clone this private repo. Fine-grained PAT scoped to the
# homelab repo only, permission "Contents: Read-only".
PORTAINER_GIT_USERNAME=Conn0r121
PORTAINER_GIT_TOKEN=github_pat_xxx
