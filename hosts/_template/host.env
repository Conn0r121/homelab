# Template for a new host: copy this directory to hosts/<hostname>/ (the name
# must match `hostname -s`, or pass it to bootstrap.sh explicitly).
# Non-secret settings only. Format: KEY=VALUE, no shell expansion.

TZ=America/New_York

# Stacks to deploy, space-separated. Each is stacks/<name>/.
STACKS=

HOMELAB_REPO_URL=https://github.com/Conn0r121/homelab.git
HOMELAB_REPO_REF=refs/heads/main
GITOPS_POLL_INTERVAL=5m

PORTAINER_DATA_DIR=/srv/portainer/data

# Per-stack settings use a <STACK>__ prefix so stacks can keep upstream
# variable names without colliding, e.g.:
# OMADA__DATA_DIR=/srv/omada/data
