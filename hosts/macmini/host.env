# Mac mini (2011, amd64, Ubuntu Server). Non-secret settings only; secrets
# live in secrets.sops.env. Format: KEY=VALUE, no shell expansion.

TZ=America/New_York

# Stacks to deploy, space-separated. Each is stacks/<name>/.
STACKS=omada immich

HOMELAB_REPO_URL=https://github.com/Conn0r121/homelab.git
HOMELAB_REPO_REF=refs/heads/main
GITOPS_POLL_INTERVAL=5m

PORTAINER_DATA_DIR=/srv/portainer/data

# --- omada ----------------------------------------------------------------
OMADA__DATA_DIR=/srv/omada/data
OMADA__LOGS_DIR=/srv/omada/logs

# --- immich -----------------------------------------------------------------
# Everything is on the HDD for now. When the SSD arrives: move DB_DATA_LOCATION
# to the SSD and set DB_STORAGE_TYPE=SSD; the library can stay on the HDD.
IMMICH__UPLOAD_LOCATION=/srv/immich/library
IMMICH__DB_DATA_LOCATION=/srv/immich/postgres
IMMICH__DB_STORAGE_TYPE=HDD
# Machine learning (faces, smart search) is off: the 2011 CPU is slow at it.
# Set to "ml" to turn it on, then re-run bootstrap.
IMMICH__COMPOSE_PROFILES=
IMMICH__DB_USERNAME=postgres
IMMICH__DB_DATABASE_NAME=immich
# IMMICH__DB_PASSWORD lives in secrets.sops.env
