# Contract for the omada stack: every key here must resolve for a host, from
# hosts/<host>/host.env or secrets. OMADA__<KEY> wins over a global <KEY>.
# Values below are examples only; bootstrap.sh never reads them.

TZ=America/New_York
# Controller state (MongoDB, config, autobackup/). Back this up.
DATA_DIR=/srv/omada/data
LOGS_DIR=/srv/omada/logs
