# Contract for the immich stack: every key here must resolve for a host, from
# hosts/<host>/host.env or secrets. IMMICH__<KEY> wins over a global <KEY>.
# Values below are examples only; bootstrap.sh never reads them.

TZ=America/New_York

# Photos/videos plus Immich's own database dumps (backups/). Back this up.
UPLOAD_LOCATION=/mnt/data/immich
# Postgres data. Must be local disk (SSD ideally), never a network share.
DB_DATA_LOCATION=/srv/immich/postgres
# HDD or SSD, matching the disk DB_DATA_LOCATION is on.
DB_STORAGE_TYPE=HDD

# "ml" runs the machine-learning container (faces, smart search).
# Empty disables it; also turn ML off in Administration > Settings.
COMPOSE_PROFILES=ml

# SECRET, so set IMMICH__DB_PASSWORD in secrets.sops.env.
# Letters and digits only (A-Za-z0-9): Immich breaks on special characters.
DB_PASSWORD=examplepassword123
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
